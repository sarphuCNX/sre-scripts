# Optional settings for run.sh in this folder. Every value has a default, so a .env is only
# needed to change one. Copy to .env in THIS folder:
#   cp .env.example .env
# Lines are parsed, never sourced. A variable already exported in your shell wins.
# Redis password: export REDISCLI_AUTH in your shell instead of putting it here.

# Redis address and database of the whiteboard update queue (defaults: 127.0.0.1, 6379, 0).
WB_QUEUE_CHECK_REDIS_HOST=127.0.0.1
WB_QUEUE_CHECK_REDIS_PORT=6379
WB_QUEUE_CHECK_REDIS_DB=0

# Seconds between the two samples (default: 120). 60 or more always covers one batch-update run.
WB_QUEUE_CHECK_SAMPLE_SECONDS=120

# UTC time the fix went live; when set, jobs kept since then are counted too (default: unset).
# --deployed-at on the command line wins over this.
# WB_QUEUE_CHECK_DEPLOYED_AT=2026-10-13T19:30:00Z

# Waiting jobs above this fail the worker check (default: 1000).
WB_QUEUE_CHECK_MAX_WAITING=1000

# Timeout per redis-cli call, in seconds (default: 10).
WB_QUEUE_CHECK_COMMAND_TIMEOUT_SECONDS=10

# Where the report log is written, relative to the directory you run from (default: ./logs).
WB_QUEUE_CHECK_LOG_DIR=./logs
