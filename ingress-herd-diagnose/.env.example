# Optional settings for run.sh in this folder. Every value has a default, so a .env is only
# needed to change one. Copy to .env in THIS folder:
#   cp .env.example .env
# Lines are parsed, never sourced. A variable already exported in your shell wins.

# Container whose json log and network namespace are read (default: brightclass-nginx).
INGRESS_DIAG_NGINX_CONTAINER=brightclass-nginx

# Socket servers whose restart is investigated. The first one's StartedAt is the default
# event time (default: "controller-server broadcast-server").
INGRESS_DIAG_SOCKET_CONTAINERS="controller-server broadcast-server"

# Upstreams whose IPs are listed to map nginx connections (default shown).
INGRESS_DIAG_UPSTREAM_CONTAINERS="controller-server broadcast-server liveclass-server kneura-web-teach-server-pm2 navneet-web-teach-server"

# Process name of the host Redis, for pgrep -o -x; its systemd unit is read from the PID (default: redis-server).
INGRESS_DIAG_REDIS_SERVICE=redis-server

# Journal window around the event time, in minutes (defaults: 20 before, 10 after).
INGRESS_DIAG_MINUTES_BEFORE=20
INGRESS_DIAG_MINUTES_AFTER=10

# How many lines are read from the END of nginx's json log (default: 100000, ~1 min of the herd).
INGRESS_DIAG_NGINX_TAIL_LINES=100000

# Timeouts in seconds: every command (default 30) and `docker logs` (default 90).
INGRESS_DIAG_COMMAND_TIMEOUT_SECONDS=30
INGRESS_DIAG_DOCKER_LOGS_TIMEOUT_SECONDS=90

# Where the report log is written, relative to the directory you run from (default: ./logs).
INGRESS_DIAG_LOG_DIR=./logs
