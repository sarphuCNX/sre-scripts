# Optional settings for run.sh in this folder. Every value has a default, so a .env is only
# needed to change one. Copy to .env in THIS folder:
#   cp .env.example .env
# Lines are parsed, never sourced. A variable already exported in your shell wins.
# --container and --since on the command line win over these.

# Container to follow (default: controller-server).
CONTAINER_DIAG_CONTAINER=controller-server

# Window when --since is not given: the last N hours (default: 6).
CONTAINER_DIAG_WINDOW_HOURS=6

# Shell history files searched for stop / start / restart commands (default shown).
CONTAINER_DIAG_HISTORY_FILES="/root/.bash_history /home/*/.bash_history"

# Lines shown from the dockerd journal (default: 40).
CONTAINER_DIAG_JOURNAL_LINES=40

# Timeout per command, in seconds (default: 30).
CONTAINER_DIAG_COMMAND_TIMEOUT_SECONDS=30

# Where the report log is written, relative to the directory you run from (default: ./logs).
CONTAINER_DIAG_LOG_DIR=./logs
