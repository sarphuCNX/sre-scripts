# Optional settings for run.sh in this folder. Every value has a default, so a .env is only
# needed to change one. Copy to .env in THIS folder:
#   cp .env.example .env
# Lines are parsed, never sourced. A variable already exported in your shell wins.
# Redis password: export REDISCLI_AUTH in your shell instead of putting it here.

# Redis process name (pgrep -x) and address (defaults: redis-server, 127.0.0.1:6379).
REDIS_DIAG_REDIS_PROCESS=redis-server
REDIS_DIAG_REDIS_HOST=127.0.0.1
REDIS_DIAG_REDIS_PORT=6379

# Window for the Redis unit journal and Redis's own log, in minutes (defaults: 10 before, 5 after).
REDIS_DIAG_UNIT_MINUTES_BEFORE=10
REDIS_DIAG_UNIT_MINUTES_AFTER=5

# Window for the whole system journal, in seconds, and how many lines to show (defaults: 60, 20, 120).
REDIS_DIAG_SYSTEM_SECONDS_BEFORE=60
REDIS_DIAG_SYSTEM_SECONDS_AFTER=20
REDIS_DIAG_SYSTEM_JOURNAL_LINES=120

# Fixed text whose journal lines are hidden as noise (default: refusing its connections).
REDIS_DIAG_JOURNAL_EXCLUDE="refusing its connections"

# Lines read from the END of Redis's own log file (default: 200000).
REDIS_DIAG_REDIS_LOG_TAIL_LINES=200000

# Cron files / directories searched for "redis" (default shown).
REDIS_DIAG_CRON_PATHS="/etc/crontab /etc/cron.d /var/spool/cron/crontabs"

# Timeout per command, in seconds (default: 30).
REDIS_DIAG_COMMAND_TIMEOUT_SECONDS=30

# Where the report log is written, relative to the directory you run from (default: ./logs).
REDIS_DIAG_LOG_DIR=./logs
