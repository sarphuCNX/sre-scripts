# Optional settings for run.sh in this folder. Every value has a default, so a .env is only
# needed to change one. Copy to .env in THIS folder:
#   cp .env.example .env
# Lines are parsed, never sourced. A variable already exported in your shell wins.

# Seconds over which counter rates (CPU split, forks/s, ListenDrops/s, ...) are sampled (default: 10).
HOST_CPU_DIAG_SAMPLE_SECONDS=10

# Seconds between the two `top` samples; the second one is reported (default: 5).
HOST_CPU_DIAG_TOP_SAMPLE_SECONDS=5

# How many processes to list by current CPU (default: 15).
HOST_CPU_DIAG_TOP_PROCESS_COUNT=15

# How many zombie parents to list (default: 5).
HOST_CPU_DIAG_ZOMBIE_PARENT_COUNT=5

# Port whose TCP connection states are counted. On bc-hetzner, 6080 is the
# cloudflared -> docker-proxy -> brightclass-nginx front door (default: 6080).
HOST_CPU_DIAG_FRONT_DOOR_PORT=6080

# Seconds before `docker ps` is abandoned (default: 15).
HOST_CPU_DIAG_DOCKER_TIMEOUT_SECONDS=15

# Seconds before ss / ps / pidof are killed; for top this is added to its sample time (default: 10).
HOST_CPU_DIAG_COMMAND_TIMEOUT_SECONDS=10

# Where the report log is written, relative to the directory you run from (default: ./logs).
#   e.g. ./logs
#   e.g. /home/ubuntu/scripts_EC2/host-cpu-diagnose/logs
HOST_CPU_DIAG_LOG_DIR=./logs
