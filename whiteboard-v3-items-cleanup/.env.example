# Settings for run.sh in this folder only. Copy to .env in THIS folder and fill in:
#   cp .env.example .env
# run.sh reads this folder's .env by default (or --env-file <path>). Lines are parsed, never
# sourced. A variable already exported in your shell wins. NEVER commit a real URI with
# credentials.

# MongoDB holding flowitems / flowitementryv3 (required).
# On the database server use the local mongod port; through a tunnel keep directConnection=true.
#   on the server    mongodb://localhost:27017/brightclass_whiteboard?directConnection=true
#   with auth        mongodb://wb_admin:<password>@localhost:27017/brightclass_whiteboard?authSource=admin&directConnection=true
#   via tunnel       mongodb://localhost:57017/brightclass_whiteboard?directConnection=true
WB_CLEANUP_MONGO_URI=mongodb://localhost:27017/brightclass_whiteboard?directConnection=true

# Database name, used only when the URI has no /<db> path (default: brightclass_whiteboard).
#   e.g. brightclass_whiteboard
WB_CLEANUP_DATABASE=brightclass_whiteboard

# Where the pre-change JSON export is written (default: ./output/whiteboard_v3_items_cleanup).
# Relative paths are resolved from the directory you run the command in.
# Each run writes <flowId>-<UTC timestamp>.json here.
#   e.g. ./output/whiteboard_v3_items_cleanup
#   e.g. /var/backups/wb-cleanup
WB_CLEANUP_BACKUP_DIR=./output/whiteboard_v3_items_cleanup

# Collection that receives the {flowId, items} backups (default: flowitems_cleanup).
# Created, with a unique flowId index, on first use. flowitems, flowitementryv3 and
# system.* names are refused, so a typo can never write into live data.
#   e.g. flowitems_cleanup
#   e.g. flowitems_cleanup_trial
WB_CLEANUP_BACKUP_COLLECTION=flowitems_cleanup
